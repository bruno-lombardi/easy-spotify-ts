{
  "name": "easy-spotify-ts",
  "version": "0.4.0",
  "description": "A Spotify Web API library in Typescript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "dependencies": {
    "axios": "^1.20.0"
  },
  "files": [
    "dist",
    "docs"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/sinon": "^22.0.0",
    "@types/sinon-chai": "^4.0.0",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "eslint": "^10.12.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.9",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.1"
  },
  "scripts": {
    "clear": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clear && tsc -p tsconfig.json",
    "build:tsc": "npm run build",
    "build:example": "tsc -p tsconfig.check.json",
    "build:all": "npm run build && npm run build:example",
    "example": "tsx examples/app.ts",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx node_modules/mocha/bin/mocha.js \"tests/**/*.spec.ts\"",
    "test:tdd": "npm test -- --watch --watch-files \"src/**/*.ts,tests/**/*.ts\"",
    "lint": "eslint src tests examples",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "c8 --include=\"src/**/*.ts\" --all --reporter=text --reporter=lcov --reporter=html npm test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "prepack": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bruno-lombardi/easy-spotify-ts"
  },
  "keywords": [
    "spotify",
    "library",
    "typescript",
    "web",
    "api",
    "spotify recommendations"
  ],
  "author": "Bruno Lombardi <djfrizer1@gmail.com> (https://github.com/bruno-lombardi)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bruno-lombardi/easy-spotify-ts/issues"
  },
  "homepage": "https://github.com/bruno-lombardi/easy-spotify-ts#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "commonjs"
}
